# OpenCode Server URL (required for frontend-only deployment)
# Set this to your OpenCode backend server URL
# Example: https://your-opencode-server.railway.app
VITE_OPENCODE_SERVER_URL=

# Optional: Custom server host and port (only used in development)
# VITE_OPENCODE_SERVER_HOST=localhost
# VITE_OPENCODE_SERVER_PORT=4096

# Optional: Sentry configuration for error tracking
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=
# VITE_SENTRY_RELEASE=

# Optional: Channel configuration (dev, beta, prod)
# VITE_OPENCODE_CHANNEL=prod
